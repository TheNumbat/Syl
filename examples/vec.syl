(* Length-indexed vectors represented as nested tuples *)
fun vec (static n : int) : erased type =
  if static n == 1 then int else int ^ vec (n - 1)
;;

let _ = (1, (2, 3)) : vec 3;;

fun replicate (static n : int) : int -> vec n =
  fn (x : int) -> if static n == 1 then x else (x, replicate (n - 1) x)
;;

let _ = replicate 4 10 : vec 4;;

let sum4 =
  fn (v : vec 4) ->
    match v with
    | a, (b, (c, d)) -> a + b + c + d
;;

let _ = print_int (sum4 (replicate 4 10));;

let safe_div =
  fn (static d : int) -> if static d != 0 then (fn (x : int) -> x / d) else unreachable
;;

let _ = print_int (safe_div 2 10);;

let safe_at =
  fn (static i : int) ->
    if static 0 <= i && i < 2
    then
      (fn (v : vec 2) ->
         match v with
         | a, b -> if static i == 0 then a else b)
    else unreachable
;;

let _ = print_int (safe_at 1 (replicate 2 9));;
