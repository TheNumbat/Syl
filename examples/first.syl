external print_bool : bool -> unit = syl_print_bool;;
external print_int : int -> unit = syl_print_int;;

fun first (x : bool) : bool =
    let id = fn (y : bool) -> y;
    if x
    then first false
    else id false
;;

fun second (x : bool) : bool =
  let f = first;
  f x
;;

let ok =
  let not_ok = let x = true; x;
  not_ok
;;

let _ = print_bool (second true);;

let _ =
  let f = fn (x : bool) -> fn (y : bool) -> print_bool x;
  let g = f false;
  g true
;;

fun recur (x : int) : int =
  if x > 0
  then recur (x - 1)
  else x
;;

let _ = print_int (recur 10);;

fun capture (x : int) : unit -> int =
  fn (_ : unit) -> x
;;

let _ = print_int (capture 10 ());;

let i = 20;;

fun capture2 (x : unit) : int = i;;

let _ = print_int (capture2 ());;
